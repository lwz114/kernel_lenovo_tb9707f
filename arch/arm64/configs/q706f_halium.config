# Ubuntu Touch / Halium 11 requirements on top of the stock Lenovo config.
# Applied as: make vendor/q706f_stock_defconfig q706f_halium.config
#
# The audio and Wi-Fi drivers only exist as prebuilt vendor modules, so the
# kernel ABI (modversions CRCs) must stay identical to stock. Options that
# change it and are not essential are left out on purpose:
#   CGROUP_PERF, NETFILTER_NETLINK_ACCT, NETFILTER_XT_MATCH_NFACCT
# SYSVIPC, POSIX_MQUEUE, FANOTIFY and CGROUP_DEVICE are kept ABI-neutral by
# the q706f changes in sched.h, sched/user.h and cgroup_subsys.h.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUP_DEVICE=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_FANOTIFY=y
CONFIG_AUTOFS4_FS=y
CONFIG_BINFMT_MISC=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZO=y
CONFIG_DNS_RESOLVER=y
# AppArmor is the primary LSM on Ubuntu Touch; SELinux stays switchable.
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_SECURITY_YAMA=y
# Android-only network restriction breaks regular Linux users.
# CONFIG_ANDROID_PARANOID_NETWORK is not set
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=y
# USB networking for early bring-up (telnet/ssh over RNDIS).
CONFIG_USB_CONFIGFS_RNDIS=y
# Crash logs across reboots.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
# The vendor modules are signed with Lenovo's build key, which this kernel does not have.
# Keep MODULE_SIG (struct module layout must not change) but stop enforcing it.
# CONFIG_MODULE_SIG_FORCE is not set
# bluebinder exposes the Android Bluetooth HAL to BlueZ through /dev/vhci.
CONFIG_BT_HCIVHCI=y
# repowerd suspends the device through /sys/power/autosleep (its libsuspend backend);
# without it the tablet never enters suspend when the display is off.
CONFIG_PM_AUTOSLEEP=y
